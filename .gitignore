## Ignore Visual Studio temporary files, build results, and
## files generated by popular .NET add-ons.

# Build results
bin/
obj/
out/

# NuGet
*.nupkg
*.snupkg
packages/
*.nuget.props
*.nuget.targets
project.assets.json
project.nuget.cache

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# OS
Thumbs.db
.DS_Store

# Kilo
.kilo/
